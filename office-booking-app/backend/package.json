{
  "name": "office-booking-app-backend",
  "version": "1.0.0",
  "description": "Express + PostgreSQL backend for the Office Desk & Room Booking App",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "psql $DATABASE_URL -f db/schema.sql",
    "seed": "node db/seed.js",
    "release-job": "node jobs/releaseNoShows.js",
    "test": "jest --runInBand",
    "test:concurrency": "node tests/concurrency.stress.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
